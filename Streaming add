<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Apps</title>

<style>
body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  margin: 0;
  padding: 20px;
}

h1 {
  text-align: center;
  color: #333;
}

#date {
  text-align: center;
  color: #666;
  margin-bottom: 20px;
}

.app {
  background: white;
  padding: 15px;
  margin: 12px 0;
  border-radius: 12px;
  box-shadow: 0 2px 6px #ccc;
}

.app a {
  text-decoration: none;
  color: #333;
  font-size: 18px;
  font-weight: bold;
}

button {
  width: 100%;
  padding: 14px;
  margin-top: 15px;
  border: none;
  border-radius: 10px;
  background: #333;
  color: white;
  font-size: 16px;
}
</style>
</head>

<body>

<h1>📱 My Apps</h1>

<div id="date"></div>

<div id="appList">

  <div class="app">
    <a href="https://www.google.com" target="_blank">
      🔎 Google
    </a>
  </div>

  <div class="app">
    <a href="https://www.youtube.com" target="_blank">
      ▶️ YouTube
    </a>
  </div>

</div>

<button onclick="addApp()">➕ Add My Own App</button>

<script>

function showDate() {
  const today = new Date();

  const options = {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric"
  };

  document.getElementById("date").innerHTML =
    today.toLocaleDateString("en-US", options);
}

function addApp() {

  let name = prompt("Enter the app name:");

  if (!name) {
    return;
  }

  let link = prompt("Enter the app website link:");

  if (!link) {
    return;
  }

  if (!link.startsWith("http://") &&
      !link.startsWith("https://")) {
    link = "https://" + link;
  }

  const app = document.createElement("div");

  app.className = "app";

  app.innerHTML =
    '<a href="' + link + '" target="_blank">📱 ' +
    name + '</a>';

  document.getElementById("appList").appendChild(app);
}

showDate();

</script>

</body>
</html>
